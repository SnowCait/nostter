{
	"name": "@nostter/nostr-kit",
	"version": "0.1.0",
	"description": "Application-independent utilities shared by Nostr clients",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SnowCait/nostter.git",
		"directory": "packages/nostr-kit"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run",
		"prepare": "npm run build",
		"lint": "prettier --ignore-path .gitignore --check . && eslint src"
	},
	"dependencies": {
		"ipaddr.js": "^2.5.0"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	}
}
