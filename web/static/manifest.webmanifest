{
	"$schema": "https://json.schemastore.org/web-manifest-combined.json",
	"name": "nostter",
	"short_name": "nostter",
	"categories": ["social"],
	"id": "/home",
	"start_url": "/home",
	"scope": "/",
	"display": "standalone",
	"description": "Nostr web client.",
	"icons": [
		{
			"src": "icon.192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any maskable monochrome"
		},
		{
			"src": "icon.512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any maskable monochrome"
		}
	],
	"protocol_handlers": [
		{
			"protocol": "web+nostr",
			"url": "/%s"
		}
	],
	"share_target": {
		"action": "/post",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [
				{
					"name": "images",
					"accept": [
						"image/*",
						".apng",
						".avif",
						".gif",
						".jpg",
						".jpeg",
						".png",
						".webp",
						".bmp",
						".svg"
					]
				}
			]
		}
	}
}
